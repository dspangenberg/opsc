# Dokku-Bootstrap-Vorlage für opsc.
# Kopieren nach deploy/.env.production und Werte eintragen.
# (deploy/.env.production ist in .gitignore – niemals committen!)

# App-Name (Default: opsc)
#APP_NAME=opsc

# Öffentliche App-Domain (ohne https://) und Postfach für Let's Encrypt
DOMAIN=app.twiceware-opsc.de
LE_EMAIL=deine@mail.de

# Pflicht-Secrets
APP_KEY=base64:...
REVERB_APP_ID=...
REVERB_APP_KEY=...
REVERB_APP_SECRET=...

# Optional
#APP_TIMEZONE=Europe/Berlin
#APP_LOCALE=de
#SENTRY_LARAVEL_DSN=
#VITE_SENTRY_ENABLED=false
#VITE_SENTRY_DNS=
#VITE_APP_NAME=opsc
#VITE_APP_URL=https://app.twiceware-opsc.de
#VITE_APP_DATE_FORMAT=dd.MM.yyyy
#VITE_APP_TIME_FORMAT=HH:mm:ss
#VITE_APP_DATE_TIME_FORMAT=dd.MM.yyyy HH:mm
#PDF_TERMS_DOCUMENT_ID=
#MAIL_MAILER=smtp
#MAIL_HOST=...
#MAIL_PORT=587
#MAIL_USERNAME=...
#MAIL_PASSWORD=...
#MAIL_ENCRYPTION=tls
